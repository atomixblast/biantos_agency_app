{
  "name": "biantos-agency",
  "version": "1.0.0",
  "description": "Application de gestion de commandes Biantos Agency",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.biantos.agency",
    "productName": "Biantos Agency",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          "**/*",
          "!node_modules/**/*",
          "!electron/**/*",
          "!dist/**/*",
          "!venv/**/*",
          "!__pycache__/**/*",
          "!*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Biantos Agency"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png"
    }
  },
  "keywords": [
    "django",
    "electron",
    "biantos",
    "gestion",
    "commandes"
  ],
  "author": "Biantos",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
